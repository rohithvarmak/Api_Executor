# Example environment configuration for Api-Executor backend
# Copy this file to `.env` and fill in actual secrets/values.

# LLM provider settings
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai  # or "anthropic"
LLM_MODEL_NAME=gpt-4o-mini

# MongoDB connection string (leave blank to disable persistence)
MONGO_URI=

# General settings
DEBUG=false
API_TIMEOUT_SECONDS=30
